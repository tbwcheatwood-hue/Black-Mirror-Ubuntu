{
  "id": "llamacpp-sycl-fp16",
  "family": "llama.cpp",
  "displayName": "llama.cpp (SYCL FP16)",
  "api": "openai",
  "serverBinary": "llama-server",
  "acceleration": "gpu-sycl",
  "os": ["linux"],
  "arch": ["x64"],
  "capabilities": {
    "thinking": "reasoning-format",
    "images": false,
    "embeddings": true,
    "logitTimingLogs": true
  },
  "hardware": {
    "requirements": ["Intel GPU with FP16 SYCL/Level Zero support"],
    "notes": "Separate from the FP32 SYCL engine. FP16 is faster on some Intel GPUs and unsupported on others. Install only after sycl-ls shows a device, and treat the first serve as experimental until Compatibility Lab passes."
  },
  "install": {
    "type": "github-release-zip",
    "repo": "ggml-org/llama.cpp",
    "assetTemplate": "llama-{tag}-bin-ubuntu-sycl-fp16-x64.tar.gz",
    "assets": {
      "linux-x64": "llama-{tag}-bin-ubuntu-sycl-fp16-x64.tar.gz"
    },
    "stableTagPointer": "https://github.com/ggml-org/llama.cpp/releases/download/v1.0.0/nightly-tag.txt",
    "fallbackTagStrategy": "latest-b-release"
  },
  "versionProbe": { "type": "cli", "args": ["--version"], "regex": "version:\\s*(\\d+)\\s*\\((\\w+)\\)" },
  "readyProbe": { "type": "http", "path": "/health", "expect": 200 },
  "defaultPort": 8087,
  "defaultBind": "127.0.0.1",
  "models": "gguf-path"
}
